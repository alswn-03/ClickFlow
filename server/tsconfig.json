{
  "compilerOptions": {
    // Environment Settings
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    // exactOptionalPropertyTypes intentionally left off: for a fast-moving
    // prototype this option mostly adds friction without much payoff (it
    // pays for itself in large, long-lived, multi-contributor codebases).
    // noUncheckedIndexedAccess and strict stay on.
    "exactOptionalPropertyTypes": false,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "src/generated"]
}
